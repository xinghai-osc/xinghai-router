# Required secrets — compose fails fast if unset. Never commit a real .env.
ENCRYPTION_KEY=replace-with-a-unique-random-secret-at-least-24-chars
# Keep URL-safe (no @ : / ? #) because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Optional overrides (compose sets REDIS_URL with REDIS_PASSWORD by default).
# REDIS_URL=redis://:password@redis:6379/0
# POSTGRES_DATA_PATH=/mnt/data/AI-Router/postgres
# REDIS_DATA_PATH=/mnt/data/AI-Router/redis

# single: local user/group concurrency; cluster: shared Redis leases + DB notifications.
DEPLOYMENT_MODE=single
# Empty selects memory for single, deny for cluster. Cluster rejects memory fallback.
# memory favors availability and can exceed global limits during outages/recovery.
# deny rejects admission on Redis errors; Redis must be reachable at startup.
REDIS_FAILURE_POLICY=
CONCURRENCY_LEASE_TTL=30s
# Cluster mode requires LOCAL_PROMPT_CACHE=false (see below).

ROUTER_PORT=8080
WEB_PORT=3000
# Public origin used for canonical URLs, robots.txt, sitemap.xml and social cards.
# Leave empty in local development to use the incoming request origin.
# NUXT_PUBLIC_SITE_URL=https://your-domain.example

# Non-compose / binary deploy (compose overrides these for the router service).
# DATABASE_URL=postgres://router:password@localhost:5432/router?sslmode=disable
# LISTEN_ADDR=:8080
# Web console proxy target when not using compose (compose sets http://router:8080).
# API_INTERNAL_URL=http://127.0.0.1:8080

# Optional Geetest v4 CAPTCHA for login/register. Leave empty to disable.
# IP-based rate limit for auth endpoints (requests per minute per IP).
# Default 10. Increase for high-traffic deployments behind a shared NAT.
IP_RATE_LIMIT_PER_MINUTE=10
# Maximum PostgreSQL connections in the pool. Leave empty to scale with the CPU count
# (16-64). A pool_max_conns parameter inside DATABASE_URL takes precedence over this.
DB_MAX_CONNS=
GEETEST_CAPTCHA_ID=
GEETEST_CAPTCHA_KEY=
# Optional Corptcha CAPTCHA for login/register. Site ID (cpt_xxx) is public, the
# secret must never reach the frontend. Leave empty to disable.
CORPTCHA_SITE_ID=
CORPTCHA_SECRET=
# Preferred captcha provider: geetest | corptcha | auto (default). The admin
# panel choice takes precedence over this.
CAPTCHA_PROVIDER=

# Optional SMTP for registration email verification codes. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Directory where conversation-cache JSON files are stored (one file per
# conversation, kept 24h and cleared at midnight). Created on first start.
# CONVERSATION_CACHE_DIR=data/conversations

# Local prompt-prefix cache: when the upstream reports zero cached tokens, the
# gateway bills overlapping prompt prefixes at the cached-input rate. In-memory
# only, bounded by LOCAL_PROMPT_CACHE_SIZE entries per model (default 4096).
# LOCAL_PROMPT_CACHE=true
# LOCAL_PROMPT_CACHE_SIZE=4096

# Optional bootstrap admin identity. User id 1 is reserved for the administrator
# on fresh installs (migration 058); set BOOTSTRAP_ADMIN_EMAIL to claim it on
# first start. The account is promoted to admin on every start, so it also
# promotes an existing account registered with the same email. When
# BOOTSTRAP_ADMIN_PASSWORD is omitted for a newly created account, a temporary
# password is generated and printed once in the router logs and must be changed
# on first sign-in.
# BOOTSTRAP_ADMIN_EMAIL=admin@localhost
# BOOTSTRAP_ADMIN_NAME=Administrator
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Go trusts forwarding headers only from these proxy IPs/CIDRs (including Nuxt).
# Nuxt separately trusts only its own edge proxies via WEB_TRUSTED_PROXIES.
# Both default empty: socket addresses only. Set explicit proxy IPs/narrow CIDRs;
# leaving Go empty behind Nuxt groups browser traffic under the Nuxt socket IP.
# X-Forwarded-For is walked right-to-left; each trusted proxy must append its
# observed peer or overwrite the header with a verified address. X-Real-IP is
# accepted only from a trusted peer when X-Forwarded-For is absent, so that peer
# must overwrite X-Real-IP. Nuxt's trusted edge must also overwrite
# X-Forwarded-Proto with exactly http or https (never a client-supplied value).
# Keywords loopback/private are supported; avoid private on shared networks.
# Binary example: Go trusts Nuxt on loopback; Nuxt directly faces browsers.
# TRUSTED_PROXIES=loopback
# WEB_TRUSTED_PROXIES=
# Compose: set TRUSTED_PROXIES to the web container IP/dedicated proxy subnet,
# and WEB_TRUSTED_PROXIES to your ingress proxy IP/CIDR only, if present.

# Browser sessions require HTTPS by default; false is for local HTTP development only.
SESSION_COOKIE_SECURE=true
# Existing plaintext channel storage is preserved until operators opt in and migrate.
# See SECURITY_MIGRATION.md before changing this policy or ENCRYPTION_KEY.
CHANNEL_CREDENTIAL_STORAGE=plaintext

# Positive byte limits; invalid/zero/negative values reject startup.
WS_MAX_MESSAGE_BYTES=2097152
HTTP_MAX_HEADER_BYTES=1048576
# Positive Go durations. Body deadline ends before SSE/upstream processing starts.
REQUEST_BODY_TIMEOUT=30s
WS_IDLE_TIMEOUT=2m
HTTP_READ_HEADER_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=2m
