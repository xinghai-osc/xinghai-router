diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..41ae01b93db23c6c6cacc18573bf27a40a2e2591
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,20 @@
+'use strict';
+
+const MAX_DEPTH = 128;
+
+const assertDepth = ast => {
+  const stack = [[ast, 0]];
+  while (stack.length > 0) {
+    const [node, depth] = stack.pop();
+    if (depth > MAX_DEPTH) {
+      throw new SyntaxError('Brace pattern exceeds maximum nesting depth');
+    }
+    if (node && Array.isArray(node.nodes)) {
+      for (const child of node.nodes) {
+        stack.push([child, depth + 1]);
+      }
+    }
+  }
+};
+
+module.exports = { MAX_DEPTH, assertDepth };
